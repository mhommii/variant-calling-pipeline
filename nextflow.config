/*
 * Pipeline configuration.
 *
 * Resources are set low on purpose: this was developed on a laptop with
 * 5.9 GB of RAM, and the defaults in most pipelines assume a server. If a
 * process asks for more memory than the machine has, Nextflow fails before
 * running anything.
 */

manifest {
    name        = 'variant-calling-pipeline'
    description = 'FASTQ to VCF: QC, alignment, variant calling, MultiQC report'
    author      = 'Mohammad Hommam Ijaz'
    mainScript  = 'main.nf'
    // Oldest version the pipeline has been run with (23.04 would not start
    // under Java 21, so it is untested rather than known to work).
    nextflowVersion = '>=23.10.0'
}

params {
    reads     = "$projectDir/data/reads/*_{1,2}.fastq.gz"
    reference = "$projectDir/data/reference.fasta"
    outdir    = 'results'
}

process {
    cpus   = 2
    memory = '2.GB'
    time   = '1.h'

    // Retry once on exit codes that signal a killed or crashed task, then
    // give up rather than loop. The retry uses the same resources, so it
    // helps with transient failures; a genuine out-of-memory will fail again.
    // Raising memory per attempt isn't an option inside a 3 GB WSL VM.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'terminate' }
    maxRetries    = 1

    // WSL is capped at 3 GB on the development laptop, so a 3 GB request
    // would never be scheduled. Aligning to the 20 kb test reference needs
    // only a few MB.
    withName: BWA_MEM {
        cpus   = 2
        memory = '2.GB'
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user so output files are not owned by root.
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    // Untested: included for HPC clusters, where Docker is rarely allowed.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // The bundled known-answer data. Same as the defaults today; kept so the
    // defaults can point at real data later without changing how tests run.
    test {
        params.reads     = "$projectDir/data/reads/*_{1,2}.fastq.gz"
        params.reference = "$projectDir/data/reference.fasta"
    }
}

// Reports describing what actually ran: useful for spotting which step is
// slow or memory-hungry.
// Overwrite so a rerun (e.g. with -resume) doesn't abort on the previous
// run's files.
timeline.enabled   = true
timeline.file      = "${params.outdir}/pipeline_info/timeline.html"
timeline.overwrite = true
report.enabled     = true
report.file        = "${params.outdir}/pipeline_info/report.html"
report.overwrite   = true
trace.enabled      = true
trace.file         = "${params.outdir}/pipeline_info/trace.txt"
trace.overwrite    = true
